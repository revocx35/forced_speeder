{
  "manifest_version": 3,
  "name": "Forced Speeder",
  "version": "1.0.0",
  "description": "Change the playback speed of any HTML5 video, even on sites that hide or lock the speed setting (e.g. Edpuzzle).",
  "homepage_url": "https://github.com/revocx35/forced_speeder",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["shared.js", "background.js"]
  },
  "action": {
    "default_title": "Forced Speeder",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "forced-speeder@revocx35.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
